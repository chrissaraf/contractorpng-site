---
import '@fontsource/fira-sans-extra-condensed/500.css';
import '@fontsource/fira-sans-extra-condensed/700.css';
import '@fontsource/fira-sans-extra-condensed/800.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  schema?: object[];
  noindex?: boolean;
}
const { title, description = site.description, schema = [], noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · Συντήρηση, επισκευή και αναβάθμιση κτιρίων`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const image = new URL('/assets/logo-original.png', site.url).href;

const org = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  '@id': `${site.url}/#company`,
  name: site.name,
  url: `${site.url}/`,
  logo: image,
  description: 'Συντήρηση, επισκευή και αναβάθμιση κτιρίων σε Αθήνα, Αττική και Κυκλάδες.',
  founder: { '@type': 'Person', name: site.ownerSchema, jobTitle: site.ownerRole },
  areaServed: site.areaServed.map((name, i) => ({ '@type': i === 0 ? 'AdministrativeArea' : 'Place', name })),
};
---
<!doctype html>
<html lang="el">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {(site.demo || noindex) && <meta name="robots" content="noindex, nofollow">}
  <meta name="theme-color" content="#FFFFFF">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="el_GR">
  <meta property="og:site_name" content={site.name}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={image}>
  <link rel="icon" type="image/png" href="/assets/favicon.png">
  <link rel="apple-touch-icon" href="/assets/icon-180.png">
  <link rel="sitemap" href="/sitemap-index.xml">
  <script type="application/ld+json" set:html={JSON.stringify([org, ...schema])} />
</head>
<body>
  {site.demo && <div class="demo-bar">ΔΕΙΓΜΑ ΣΧΕΔΙΟΥ · ό,τι είναι σε [αγκύλες] περιμένει τα στοιχεία της εταιρείας</div>}
  <Header />
  <main id="top">
    <slot />
  </main>
  <Footer />
  <script>
    import '../scripts/caps';
    import '../scripts/menu';
  </script>
</body>
</html>
