---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { services, type Service } from '../../data/services';
import { projectsFor } from '../../data/projects';
import { site } from '../../data/site';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props as { s: Service };
const related = projectsFor(s.slug);
const others = services.filter((o) => o.slug !== s.slug);
const url = `${site.url}/ypiresies/${s.slug}/`;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: s.title,
    serviceType: s.seoTitle,
    description: s.short,
    url,
    provider: { '@id': `${site.url}/#company` },
    areaServed: site.areaServed,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Αρχική', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Υπηρεσίες', item: `${site.url}/ypiresies/` },
      { '@type': 'ListItem', position: 3, name: s.title, item: url },
    ],
  },
];
---
<Base title={s.seoTitle} description={s.short} schema={schema}>
  <PageHero crumbs={[{ href: '/', label: 'Αρχική' }, { href: '/ypiresies/', label: 'Υπηρεσίες' }, { label: s.code }]} title={s.title} lead={s.intro}>
    <div class="hero-cta">
      <a class="btn" href={`/epikoinonia/?t=${encodeURIComponent(s.formType)}#form`}>Ζητήστε προσφορά <span aria-hidden="true">→</span></a>
      {related.length > 0 && <a class="btn btn-ghost" href="#erga">Σχετικά έργα</a>}
    </div>
  </PageHero>

  <section>
    <div class="wrap detail">
      <div class="prose">
        <h2>Τι κάνουμε</h2>
        {s.body.map((p) => <p>{p}</p>)}
        <h2>Τι περιλαμβάνει</h2>
        <ul class="checks">{s.includes.map((i) => <li>{i}</li>)}</ul>
      </div>
      <aside class="aside">
        <span class="label">{s.code} · {s.kicker}</span>
        <h2>Αυτοψία και προσφορά</h2>
        <p>Ερχόμαστε στον χώρο, καταγράφουμε τις εργασίες και σας δίνουμε αναλυτική προσφορά ανά άρθρο.</p>
        <p class="label">Για ποιους</p>
        <div class="chips">{s.forWhom.map((w) => <span>{w}</span>)}</div>
        <a class="btn" href={`/epikoinonia/?t=${encodeURIComponent(s.formType)}#form`}>Ζητήστε προσφορά <span aria-hidden="true">→</span></a>
      </aside>
    </div>
  </section>

  {related.length > 0 && (
    <section id="erga" class="projects">
      <div class="wrap">
        <div class="sec-head">
          <div class="sec-tag label">Έργα</div>
          <div><h2>Σχετικά έργα</h2><p>Έργα αυτής της κατηγορίας που μας εμπιστεύτηκαν, σε σχέδιο, χωρίς στοιχεία των πελατών.</p></div>
        </div>
        <div class="proj-grid">
          {related.map((p) => <ProjectCard p={p} wide={false} />)}
        </div>
      </div>
    </section>
  )}

  <section>
    <div class="wrap">
      <div class="sec-head">
        <div class="sec-tag label">Υπηρεσίες</div>
        <div><h2>Άλλες υπηρεσίες</h2></div>
      </div>
      <div class="svc-links">
        {others.map((o) => <a href={`/ypiresies/${o.slug}/`}><b>{o.title}</b><span>{o.code}</span></a>)}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<script>
  import '../../scripts/drawings';
</script>
