---
import Base from '../layouts/Base.astro';
---
<Base title="Η σελίδα δεν βρέθηκε" noindex>
  <section>
    <div class="wrap notfound">
      <p class="label">Σφάλμα 404</p>
      <h1 style="font-size:clamp(44px,7vw,96px);text-transform:uppercase">Δεν βρέθηκε</h1>
      <p>Η σελίδα που ζητήσατε δεν υπάρχει. Δείτε την αρχική ή ζητήστε προσφορά.</p>
      <div class="hero-cta"><a class="btn" href="/">Στην αρχική</a><a class="btn btn-ghost" href="/epikoinonia/#form">Ζητήστε προσφορά</a></div>
    </div>
  </section>
</Base>
